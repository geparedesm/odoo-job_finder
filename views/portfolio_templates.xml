<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portfolio_page" name="Portfolio">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="pageName" t-value="'jf-portfolio-page'"/>
            <t t-set="additional_title" t-value="portfolio.get('name') or 'Portfolio'"/>
            <t t-set="head">
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&amp;family=Space+Grotesk:wght@500;600&amp;display=swap"/>
            </t>
            <t t-set="p" t-value="portfolio"/>
            <div id="wrap" class="jf-portfolio">
                <t t-if="not profile">
                    <section class="jf-empty">
                        <h1>Portfolio coming soon</h1>
                        <p>Check back soon.</p>
                    </section>
                </t>
                <t t-else="">
                    <header class="jf-nav" role="banner">
                        <a href="#home" class="jf-wordmark" t-out="p['name']"/>
                        <nav class="jf-nav-links" aria-label="Sections">
                            <a t-if="p['featured_projects']" href="#work">Work</a>
                            <a t-if="p['roles']" href="#experience">Experience</a>
                            <a t-if="p['research_groups']" href="#research">Research</a>
                            <a t-if="p['skills']" href="#skills">Skills</a>
                            <a t-if="p['education'] or p['trainings'] or p['languages']" href="#education">Education</a>
                            <a t-if="p['volunteering']" href="#community">Community</a>
                            <a href="#contact">Contact</a>
                        </nav>
                        <div class="jf-nav-actions">
                            <div t-if="len(frontend_languages) &gt; 1" class="jf-lang" aria-label="Language">
                                <t t-foreach="frontend_languages.values()" t-as="lg">
                                    <span t-if="not lg_first" class="jf-lang-sep" aria-hidden="true">/</span>
                                    <a t-att-href="url_localized(lang_code=lg.code, prefetch_langs=True, force_default_lang=True)"
                                       t-att-hreflang="lg.url_code" t-att-aria-current="'true' if lg.code == lang else None"
                                       t-attf-class="jf-lang-link #{'is-active' if lg.code == lang else ''}"
                                       t-out="lg.url_code.split('_')[0].upper()"/>
                                </t>
                            </div>
                            <a href="/portfolio/cv" class="jf-button jf-button-primary jf-nav-cv">
                                <i class="fa fa-download" aria-hidden="true"/> <span>Download CV</span>
                            </a>
                            <details class="jf-menu">
                                <summary aria-label="Menu"><i class="fa fa-bars" aria-hidden="true"/></summary>
                                <nav class="jf-menu-links" aria-label="Sections">
                                    <a t-if="p['featured_projects']" href="#work">Work</a>
                                    <a t-if="p['roles']" href="#experience">Experience</a>
                                    <a t-if="p['research_groups']" href="#research">Research</a>
                                    <a t-if="p['skills']" href="#skills">Skills</a>
                                    <a t-if="p['education'] or p['trainings'] or p['languages']" href="#education">Education</a>
                                    <a t-if="p['volunteering']" href="#community">Community</a>
                                    <a href="#contact">Contact</a>
                                    <a href="/portfolio/cv">Download CV</a>
                                </nav>
                            </details>
                        </div>
                    </header>

                    <main>
                        <section id="home" class="jf-hero">
                            <div class="jf-hero-content">
                                <p t-if="p['location']" class="jf-location"><i class="fa fa-map-marker" aria-hidden="true"/> <span t-out="p['location']"/></p>
                                <h1 class="jf-name" t-out="p['name']"/>
                                <p t-if="p['headline_parts']" class="jf-disciplines">
                                    <t t-foreach="p['headline_parts']" t-as="part">
                                        <span t-if="not part_first" class="jf-dot" aria-hidden="true"/>
                                        <span t-out="part"/>
                                    </t>
                                </p>
                                <p t-foreach="p['summary_paragraphs']" t-as="paragraph" class="jf-summary" t-out="paragraph"/>
                                <div class="jf-actions">
                                    <a t-if="p['email']" t-attf-href="mailto:#{p['email']}" class="jf-button jf-button-primary jf-button-large">
                                        <i class="fa fa-envelope-o" aria-hidden="true"/> <span>Email me</span>
                                    </a>
                                    <a t-else="" href="/portfolio/cv" class="jf-button jf-button-primary jf-button-large">
                                        <i class="fa fa-download" aria-hidden="true"/> <span>Download CV</span>
                                    </a>
                                    <a t-if="p['featured_projects']" href="#work" class="jf-button jf-button-outline jf-button-large">See selected work</a>
                                </div>
                                <ul t-if="p['links']" class="jf-links">
                                    <li t-foreach="p['links']" t-as="item">
                                        <a t-att-href="item['href']" target="_blank" rel="noopener">
                                            <i t-attf-class="fa #{item['icon']}" aria-hidden="true"/>
                                            <span t-out="item['label']"/>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                            <div t-if="p['has_photo']" class="jf-portrait">
                                <div class="jf-portrait-glow" aria-hidden="true"/>
                                <img src="/portfolio/photo" t-att-alt="p['name']" class="jf-portrait-photo" width="540" height="560"/>
                                <div class="jf-portrait-fade" aria-hidden="true"/>
                            </div>
                        </section>

                        <section t-if="p['featured_projects']" id="work" class="jf-section">
                            <div class="jf-heading">
                                <h2>Selected work</h2>
                                <p class="jf-intro">Projects from my professional roles.</p>
                            </div>
                            <div class="jf-rows">
                                <article t-foreach="p['featured_projects']" t-as="project" class="jf-row jf-project">
                                    <div class="jf-project-title">
                                        <h3>
                                            <a t-if="project['url']" t-att-href="project['url']" target="_blank" rel="noopener" t-out="project['name']"/>
                                            <t t-else="" t-out="project['name']"/>
                                        </h3>
                                        <p t-if="project['subtitle']" class="jf-accent" t-out="project['subtitle']"/>
                                        <p t-if="project['source']" class="jf-muted jf-small" t-out="project['source']"/>
                                    </div>
                                    <p class="jf-project-description" t-out="project['description']"/>
                                    <div t-if="project['technologies']" class="jf-project-tech">
                                        <span class="jf-label">Technologies</span>
                                        <span class="jf-tech" t-out="project['technologies']"/>
                                    </div>
                                </article>
                            </div>
                        </section>

                        <section t-if="p['roles']" id="experience" class="jf-section">
                            <div class="jf-heading"><h2>Experience</h2></div>
                            <div class="jf-rows">
                                <article t-foreach="p['roles']" t-as="role" class="jf-row jf-role">
                                    <span class="jf-role-period jf-accent" t-out="role['period']"/>
                                    <div class="jf-role-title">
                                        <h3 t-out="role['title']"/>
                                        <p t-if="role['detail']" class="jf-muted" t-out="role['detail']"/>
                                    </div>
                                    <span class="jf-role-location" t-out="role['location']"/>
                                    <span class="jf-role-type jf-muted" t-out="role['type']"/>
                                </article>
                            </div>
                        </section>

                        <section t-if="p['research_groups']" id="research" class="jf-section">
                            <div class="jf-heading"><h2>Research and academic projects</h2></div>
                            <div class="jf-groups">
                                <div t-foreach="p['research_groups']" t-as="group" class="jf-group">
                                    <div class="jf-group-heading">
                                        <h3 t-out="group['organisation']"/>
                                        <p t-if="group['role']" class="jf-accent" t-out="group['role']"/>
                                        <p t-if="group['meta']" class="jf-muted jf-small" t-out="group['meta']"/>
                                    </div>
                                    <ul class="jf-group-items">
                                        <li t-foreach="group['items']" t-as="item">
                                            <h4 t-out="item['name']"/>
                                            <span t-if="item['technologies']" class="jf-tech" t-out="item['technologies']"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </section>

                        <section t-if="p['skills']" id="skills" class="jf-section">
                            <div class="jf-heading"><h2>Skills</h2></div>
                            <div class="jf-rows">
                                <div t-foreach="p['skills']" t-as="skill" class="jf-row jf-skill">
                                    <h3 t-out="skill['name']"/>
                                    <p t-out="skill['items']"/>
                                </div>
                            </div>
                        </section>

                        <section t-if="p['education'] or p['trainings'] or p['languages']" id="education" class="jf-section jf-columns">
                            <div class="jf-column">
                                <div t-if="p['education']" class="jf-block">
                                    <h2 class="jf-h2-small">Education</h2>
                                    <div t-foreach="p['education']" t-as="entry" class="jf-education">
                                        <h3 t-out="entry['qualification']"/>
                                        <p class="jf-muted" t-out="entry['meta']"/>
                                    </div>
                                </div>
                                <div t-if="p['languages']" class="jf-block">
                                    <h2 class="jf-h2-small">Languages</h2>
                                    <ul class="jf-languages">
                                        <li t-foreach="p['languages']" t-as="language">
                                            <span class="jf-language" t-out="language['name']"/>
                                            <span t-if="language['level']" class="jf-tech" t-out="language['level']"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div t-if="p['trainings']" class="jf-column jf-block">
                                <h2 class="jf-h2-small">Training and credentials</h2>
                                <div class="jf-rows">
                                    <div t-foreach="p['trainings']" t-as="training" class="jf-row jf-training">
                                        <div>
                                            <p class="jf-training-name" t-out="training['name']"/>
                                            <p t-if="training['meta']" class="jf-muted jf-small" t-out="training['meta']"/>
                                        </div>
                                        <span class="jf-accent" t-out="training['year']"/>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section t-if="p['volunteering']" id="community" class="jf-section">
                            <div class="jf-heading"><h2>Leadership and volunteering</h2></div>
                            <div class="jf-community">
                                <article t-foreach="p['volunteering']" t-as="entry" class="jf-community-entry">
                                    <h3 t-out="entry['title']"/>
                                    <p t-if="entry['meta']" class="jf-muted jf-small" t-out="entry['meta']"/>
                                    <p t-if="entry['highlight']" t-out="entry['highlight']"/>
                                    <ul t-if="entry['recognitions']" class="jf-recognitions">
                                        <li t-foreach="entry['recognitions']" t-as="line" t-out="line"/>
                                    </ul>
                                </article>
                            </div>
                        </section>

                        <section id="contact" class="jf-section jf-contact">
                            <div class="jf-contact-lead">
                                <h2>Contact</h2>
                                <a t-if="p['email']" t-attf-href="mailto:#{p['email']}" class="jf-contact-email" t-out="p['email']"/>
                            </div>
                            <dl class="jf-contact-details">
                                <div t-if="p['phone']">
                                    <dt><i class="fa fa-phone" aria-hidden="true"/> Phone</dt>
                                    <dd><a t-attf-href="tel:#{p['phone'].replace(' ', '')}" t-out="p['phone']"/></dd>
                                </div>
                                <div t-if="p['location']">
                                    <dt><i class="fa fa-map-marker" aria-hidden="true"/> Location</dt>
                                    <dd t-out="p['location']"/>
                                </div>
                                <div t-foreach="p['links']" t-as="item">
                                    <dt>
                                        <i t-attf-class="fa #{item['icon']}" aria-hidden="true"/>
                                        <t t-if="item['kind'] == 'linkedin'">LinkedIn</t>
                                        <t t-elif="item['kind'] == 'github'">GitHub</t>
                                        <t t-else="">Website</t>
                                    </dt>
                                    <dd><a t-att-href="item['href']" target="_blank" rel="noopener" t-out="item['label']"/></dd>
                                </div>
                            </dl>
                        </section>
                    </main>

                    <footer class="jf-footer">
                        <p class="jf-muted jf-small">
                            <span t-out="p['name']"/><t t-if="p['headline_parts']"> / <t t-out="', '.join(p['headline_parts'])"/></t>
                        </p>
                        <a href="/portfolio/cv" class="jf-footer-cv"><i class="fa fa-download" aria-hidden="true"/> <span>Download complete CV (PDF)</span></a>
                    </footer>
                </t>
            </div>
        </t>
    </template>
</odoo>
