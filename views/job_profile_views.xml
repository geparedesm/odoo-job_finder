<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form" model="ir.ui.view">
        <field name="name">job.profile.form</field>
        <field name="model">job.profile</field>
        <field name="arch" type="xml">
            <form string="My Profile">
                <header>
                    <button name="action_parse_cv" type="object" string="Analyze CV"
                            class="oe_highlight" invisible="not cv_file"
                            confirm="Analyzing the CV replaces the entries of every section it finds. Continue?"/>
                    <button name="%(action_job_finder_cv_download)d" type="action" string="Download CV"
                            context="{'default_profile_id': id}"/>
                </header>
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar" options="{'preview_image': 'photo'}"/>
                    <div class="oe_title" name="identity">
                        <h1><field name="full_name" placeholder="Your full name"/></h1>
                        <h3><field name="headline" placeholder="Your role or professional headline"/></h3>
                        <div class="d-flex align-items-center gap-2" groups="base.group_system">
                            <field name="is_published_as_portfolio" widget="boolean_toggle" nolabel="1"/>
                            <label for="is_published_as_portfolio"/>
                        </div>
                    </div>
                    <group name="overview">
                        <group string="Ways to reach you" name="contact_channels">
                            <field name="location"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="linkedin" placeholder="https://www.linkedin.com/in/your-profile"/>
                            <field name="website" placeholder="https://your-site.com"/>
                            <field name="github" placeholder="https://github.com/your-user"/>
                        </group>
                        <group string="Profile completeness" name="completeness">
                            <field name="completeness" widget="progressbar" nolabel="1" colspan="2"/>
                            <field name="completeness_hints" nolabel="1" colspan="2" class="text-muted"
                                   invisible="not completeness_hints"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary" name="summary">
                            <field name="summary" placeholder="Describe your professional background and career goals."/>
                        </page>
                        <page string="Experience" name="experience">
                            <field name="experience_ids" context="{'default_profile_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="role"/>
                                    <field name="company"/>
                                    <field name="location" optional="show"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="is_current" optional="hide"/>
                                    <field name="employment_type" optional="show"/>
                                    <field name="category" optional="show"/>
                                    <field name="project_ids" widget="many2many_tags" string="Projects" optional="show"/>
                                    <field name="profile_id" column_invisible="True"/>
                                    <field name="cv_area_ids" widget="many2many_tags" optional="show"/>
                                    <field name="is_public" widget="boolean_toggle"/>
                                    <field name="is_secondary" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Projects" name="projects">
                            <field name="project_ids" context="{'default_profile_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="is_featured" widget="boolean_favorite" nolabel="1"/>
                                    <field name="name"/>
                                    <field name="subtitle" optional="show"/>
                                    <field name="profile_id" column_invisible="True"/>
                                    <field name="experience_id" optional="show"/>
                                    <field name="category"/>
                                    <field name="technology_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    <field name="description" optional="hide"/>
                                    <field name="url" optional="hide"/>
                                    <field name="cv_area_ids" widget="many2many_tags" optional="show"/>
                                    <field name="is_public" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Skills" name="skills">
                            <field name="skill_group_ids" context="{'default_profile_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="technology_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    <field name="profile_id" column_invisible="True"/>
                                    <field name="cv_area_ids" widget="many2many_tags" optional="show"/>
                                    <field name="is_public" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Education" name="education">
                            <field name="education_ids" context="{'default_profile_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="qualification"/>
                                    <field name="code" optional="show"/>
                                    <field name="institution"/>
                                    <field name="location" optional="show"/>
                                    <field name="year_start"/>
                                    <field name="year_end"/>
                                    <field name="status"/>
                                    <field name="is_public" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Trainings" name="trainings">
                            <field name="training_ids" context="{'default_profile_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="issuer"/>
                                    <field name="year"/>
                                    <field name="status"/>
                                    <field name="profile_id" column_invisible="True"/>
                                    <field name="cv_area_ids" widget="many2many_tags" optional="show"/>
                                    <field name="is_public" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Volunteering" name="volunteering">
                            <field name="volunteering_ids" context="{'default_profile_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="title"/>
                                    <field name="organisation"/>
                                    <field name="location" optional="show"/>
                                    <field name="period"/>
                                    <field name="profile_id" column_invisible="True"/>
                                    <field name="cv_area_ids" widget="many2many_tags" optional="show"/>
                                    <field name="is_public" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Languages" name="languages">
                            <field name="spoken_language_ids" context="{'default_profile_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="level"/>
                                    <field name="is_public" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="CV areas" name="cv_areas">
                            <div class="alert alert-info" role="status" name="cv_areas_guidance">
                                Create the areas you apply for (Frontend, Backend, DevOps, Hospitality…) and tag the
                                roles, projects, skills, trainings and volunteering of each one in their tabs. A CV for
                                some areas keeps their entries and the untagged ones; education and languages are
                                always included.
                            </div>
                            <field name="cv_area_ids" context="{'default_profile_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="headline" placeholder="Defaults to your headline"/>
                                    <field name="summary" placeholder="Defaults to your summary" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Portfolio" name="portfolio">
                            <group name="portfolio_options">
                                <field name="tagline" placeholder="Defaults to the first sentence of your summary"/>
                                <field name="availability_note" placeholder="Open to software &amp; ICT roles"/>
                                <field name="secondary_experience_title" placeholder="Other experience"/>
                                <field name="is_phone_public"/>
                            </group>
                            <group string="Section headlines" name="headlines">
                                <field name="work_heading" placeholder="Selected work"/>
                                <field name="experience_heading" placeholder="Experience"/>
                                <field name="skills_heading" placeholder="Skills"/>
                                <field name="about_heading" placeholder="Background"/>
                                <field name="contact_heading" placeholder="Let's work together."/>
                            </group>
                            <separator string="Key figures"/>
                            <field name="figure_ids" context="{'default_profile_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="value" placeholder="55k+"/>
                                    <field name="label" placeholder="App downloads"/>
                                    <field name="is_public" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <group string="Search engines and sharing" name="seo">
                                <field name="website_meta_title" placeholder="Defaults to your name and headline"/>
                                <field name="website_meta_description" placeholder="Defaults to your summary"/>
                                <field name="website_meta_keywords"/>
                                <field name="website_meta_og_img" placeholder="Defaults to your photo"/>
                            </group>
                        </page>
                        <page string="CV import" name="cv_import">
                            <group name="cv_upload">
                                <div class="alert alert-info" role="status" name="cv_guidance" colspan="2">
                                    <strong>Start with your CV</strong>
                                    <p>Upload your PDF CV, then click Analyze CV to fill in your profile. Review the imported entries in each tab and complete any missing information.</p>
                                </div>
                                <field name="cv_file" filename="cv_filename"/>
                                <field name="cv_filename" invisible="True"/>
                                <field name="cv_parsed_date" readonly="True"/>
                            </group>
                            <group string="Imported text" name="imported_text">
                                <field name="experience"/>
                                <field name="projects"/>
                                <field name="skills"/>
                                <field name="education"/>
                                <field name="trainings"/>
                                <field name="volunteering"/>
                                <field name="languages"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_list" model="ir.ui.view">
        <field name="name">job.profile.list</field>
        <field name="model">job.profile</field>
        <field name="arch" type="xml">
            <list string="Profiles">
                <field name="full_name"/>
                <field name="headline"/>
                <field name="email"/>
                <field name="completeness" widget="progressbar"/>
            </list>
        </field>
    </record>
</odoo>
