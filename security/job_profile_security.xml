<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="job_profile_rule_user" model="ir.rule">
        <field name="name">Perfil propio del usuario</field>
        <field name="model_id" ref="model_job_profile"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <!-- Group rules are combined with OR, preserving full administrator access. -->
    <record id="job_profile_rule_system" model="ir.rule">
        <field name="name">Todos los perfiles para administradores</field>
        <field name="model_id" ref="model_job_profile"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
