        {
          "type": "text",
          "id": "xtuBD",
          "name": "Typography specification",
          "fill": "$pf-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Reference-led direction: dark navy #070B12, raised surfaces #101925, violet #9054FA, cyan #30D4FF, readable foreground #F4F6FF and body #B4C0D5. Space Grotesk for titles; IBM Plex Sans for body and controls. Rounded project panels, fine borders, restrained luminous accents.",
          "lineHeight": 1.5,
          "fontFamily": "IBM Plex Sans",
          "fontSize": 17,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "pknzp",
          "name": "UX flow heading",
          "fill": "$pf-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Navigation & interaction",
          "fontFamily": "Barlow Condensed",
          "fontSize": 30,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "Pn5Nk",
          "name": "Navigation behavior",
          "fill": "$pf-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Home → Selected work → Experience → Research → Skills → Education → Community → Contact. Navigation lists only sections whose field is set. Download CV → job_finder complete CV report. EN / ES → i18n of fixed labels; profile text is shown as entered. Mobile menu exposes the same sections.",
          "lineHeight": 1.5,
          "fontFamily": "IBM Plex Sans",
          "fontSize": 17,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "uonqc",
          "name": "States heading",
          "fill": "$pf-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Accessible states",
          "fontFamily": "Barlow Condensed",
          "fontSize": 30,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "u13LZV",
          "name": "Accessibility specification",
          "fill": "$pf-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Controls use 44px minimum touch targets. Keyboard focus: 2px cyan outline with offset; hover: lighter violet border and underlined links. Project cards open a case study; technologies can filter the project list. Mobile uses a single column and explicit menu. Motion must respect reduced-motion preferences.",
          "lineHeight": 1.5,
          "fontFamily": "IBM Plex Sans",
          "fontSize": 17,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "eWgqt",
          "name": "Content heading",
          "fill": "$pf-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Content provenance & review",
          "fontFamily": "Barlow Condensed",
          "fontSize": 30,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "A0exXg",
          "name": "Source notes",
          "fill": "$pf-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Content source: the job.profile record (sample: tests/fixtures/complete_cv_expected.json). See the board 'Profile data binding' for the field of every element. The cover image is decorative and not a product screenshot; no portrait is assumed.",
          "lineHeight": 1.5,
          "fontFamily": "IBM Plex Sans",
          "fontSize": 17,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "VPJcP",
          "name": "Design review",
          "fill": "$pf-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Visual reference supplied by the user: dark technical portfolio with violet and cyan accents, connected device imagery, six project cards, grouped skills and compact career columns. Adapted to 1440px desktop and 390px mobile. CV facts take precedence over text in the image.",
          "lineHeight": 1.5,
          "fontFamily": "IBM Plex Sans",
          "fontSize": 17,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "UV5S8",
          "name": "Prototype scope",
          "fill": "$pf-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The 'Profile-bound' screens supersede the previous hand-written screens. Section titles are fixed labels; everything else is profile data.",
          "lineHeight": 1.5,
          "fontFamily": "IBM Plex Sans",
          "fontSize": 15,
          "fontWeight": "normal"
        }
      ]
    },
