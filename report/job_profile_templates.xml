<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A role or a research collaboration: title, company and dates, then highlights and projects as bullets. -->
    <template id="report_job_profile_role">
        <div class="jf-cv-entry">
            <div class="jf-cv-entry-head">
                <div class="jf-cv-entry-title">
                    <strong t-out="role['title']"/><t t-if="role['company']"> — <span t-out="role['company']"/></t>
                </div>
                <div class="jf-cv-entry-date" t-out="role['period']"/>
            </div>
            <p t-if="role['location'] or role['type']" class="jf-cv-entry-meta"
               t-out="' · '.join(filter(None, [role['location'], role['type']]))"/>
            <p t-if="role['description']" class="jf-cv-text" t-out="role['description']"/>
            <ul t-if="role['highlights'] or role['projects']" class="jf-cv-bullets">
                <li t-foreach="role['highlights']" t-as="line" t-out="line"/>
                <li t-foreach="role['projects']" t-as="project">
                    <t t-call="job_finder.report_job_profile_project"/>
                </li>
            </ul>
        </div>
    </template>

    <template id="report_job_profile_project">
        <strong t-out="project['name']"/><t t-if="project['subtitle']"> (<t t-out="project['subtitle']"/>)</t><t t-if="project['description']">: <t t-out="project['description']"/></t>
        <span t-if="project['technologies']" class="jf-cv-tech"><span>Technologies</span>: <t t-out="project['technologies']"/></span>
    </template>

    <template id="report_job_profile">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="profile">
                <t t-set="cv" t-value="cvs[profile.id]"/>
                <t t-call="web.basic_layout">
                    <div class="page jf-cv">
                        <header class="jf-cv-header">
                            <h1 class="jf-cv-name" t-out="cv['name']"/>
                            <p t-if="cv['headline']" class="jf-cv-headline" t-out="cv['headline']"/>
                            <p t-if="cv['contact']" class="jf-cv-contact">
                                <t t-foreach="cv['contact']" t-as="item">
                                    <span t-if="not item_first" class="jf-cv-sep">|</span>
                                    <a t-if="item['href']" t-att-href="item['href']" class="jf-cv-contact-item" t-out="item['label']"/>
                                    <span t-else="" class="jf-cv-contact-item" t-out="item['label']"/>
                                </t>
                            </p>
                        </header>

                        <section t-if="cv['summary_paragraphs']" class="jf-cv-section">
                            <h2>Professional summary</h2>
                            <p t-foreach="cv['summary_paragraphs']" t-as="paragraph" class="jf-cv-text" t-out="paragraph"/>
                        </section>

                        <section t-if="cv['skills']" class="jf-cv-section">
                            <h2>Skills</h2>
                            <p t-foreach="cv['skills']" t-as="skill" class="jf-cv-skill">
                                <strong t-out="skill['name']"/>: <t t-out="skill['items']"/>
                            </p>
                        </section>

                        <section t-if="cv['roles']" class="jf-cv-section">
                            <h2>Experience</h2>
                            <t t-foreach="cv['roles']" t-as="role" t-call="job_finder.report_job_profile_role"/>
                        </section>

                        <section t-if="cv['projects']" class="jf-cv-section">
                            <h2>Projects</h2>
                            <ul class="jf-cv-bullets">
                                <li t-foreach="cv['projects']" t-as="project">
                                    <t t-call="job_finder.report_job_profile_project"/>
                                </li>
                            </ul>
                        </section>

                        <section t-if="cv['research']" class="jf-cv-section">
                            <h2>Research and academic projects</h2>
                            <t t-foreach="cv['research']" t-as="role" t-call="job_finder.report_job_profile_role"/>
                        </section>

                        <section t-if="cv['education']" class="jf-cv-section">
                            <h2>Education</h2>
                            <div t-foreach="cv['education']" t-as="entry" class="jf-cv-entry">
                                <div class="jf-cv-entry-head">
                                    <div class="jf-cv-entry-title"><strong t-out="entry['qualification']"/></div>
                                    <div class="jf-cv-entry-date" t-out="entry['period']"/>
                                </div>
                                <p t-if="entry['institution'] or entry['details']" class="jf-cv-entry-meta"
                                   t-out="' · '.join(filter(None, [entry['institution'], entry['details']]))"/>
                            </div>
                        </section>

                        <section t-if="cv['trainings']" class="jf-cv-section">
                            <h2>Certifications and training</h2>
                            <ul class="jf-cv-bullets">
                                <li t-foreach="cv['trainings']" t-as="training">
                                    <strong t-out="training['name']"/><t t-if="training['details']"> · <t t-out="training['details']"/></t>
                                </li>
                            </ul>
                        </section>

                        <section t-if="cv['volunteering']" class="jf-cv-section">
                            <h2>Leadership and volunteering</h2>
                            <div t-foreach="cv['volunteering']" t-as="entry" class="jf-cv-entry">
                                <div class="jf-cv-entry-head">
                                    <div class="jf-cv-entry-title">
                                        <strong t-out="entry['title']"/><t t-if="entry['organisation']"> — <span t-out="entry['organisation']"/></t>
                                    </div>
                                    <div class="jf-cv-entry-date" t-out="entry['period']"/>
                                </div>
                                <ul t-if="entry['recognitions'] or entry['highlights']" class="jf-cv-bullets">
                                    <li t-foreach="entry['recognitions']" t-as="line" t-out="line"/>
                                    <li t-foreach="entry['highlights']" t-as="line" t-out="line"/>
                                </ul>
                            </div>
                        </section>

                        <section t-if="cv['languages']" class="jf-cv-section">
                            <h2>Languages</h2>
                            <p class="jf-cv-text">
                                <t t-foreach="cv['languages']" t-as="language">
                                    <t t-if="not language_first"> · </t><strong t-out="language['name']"/><t t-if="language['level']"> (<t t-out="language['level']"/>)</t>
                                </t>
                            </p>
                        </section>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
