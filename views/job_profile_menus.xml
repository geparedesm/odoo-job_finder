<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_my_profile" model="ir.actions.act_window">
        <field name="name">Mi Perfil</field>
        <field name="res_model">job.profile</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_form"/>
        <field name="target">current</field>
    </record>
    <record id="action_open_my_profile" model="ir.actions.server">
        <field name="name">Abrir mi perfil</field>
        <field name="model_id" ref="model_job_profile"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_my_profile()</field>
    </record>
    <menuitem id="menu_root" name="Job Finder" sequence="10"/>
    <menuitem id="menu_my_profile" name="Mi Perfil"
              parent="menu_root" action="action_open_my_profile"
              sequence="10"/>
    <record id="action_job_postings" model="ir.actions.act_window">
        <field name="name">Ofertas de empleo</field>
        <field name="res_model">job.posting</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_job_postings" name="Ofertas de empleo"
              parent="menu_root" action="action_job_postings"
              groups="base.group_user" sequence="20"/>
</odoo>
