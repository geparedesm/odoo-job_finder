<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.job.finder</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Job Finder" name="job_finder" groups="base.group_system">
                    <block title="Proveedores de ofertas online">
                        <setting string="Adzuna" help="Sin credenciales se omite este proveedor.">
                            <div class="content-group">
                                <field name="adzuna_app_id" placeholder="App ID"/>
                                <field name="adzuna_app_key" password="True" placeholder="App Key"/>
                                <field name="adzuna_country"/>
                            </div>
                        </setting>
                        <setting string="Jooble" help="Arbeitnow y RemoteOK se consultan sin credenciales.">
                            <field name="jooble_api_key" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
