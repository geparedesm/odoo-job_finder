<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portfolio_page" name="Public portfolio">
        <t t-call="web.html_container">
            <t t-set="name" t-value="profile.full_name or profile.user_id.name"/>
            <t t-set="headline" t-value="profile.headline or 'Software developer and problem solver'"/>
            <main class="pf-page" t-att-data-slug="profile.portfolio_slug">
                <nav class="pf-nav" aria-label="Portfolio sections">
                    <a class="pf-wordmark" href="#top">
                        <span class="pf-mark" t-esc="profile.portfolio_initials"/>
                        <span t-esc="name"/>
                    </a>
                    <div class="pf-nav-links">
                        <a href="#work">Work</a>
                        <a href="#experience">Experience</a>
                        <a href="#about">About</a>
                        <a href="#contact">Contact</a>
                    </div>
                </nav>

                <header class="pf-hero" id="top">
                    <p class="pf-kicker" t-esc="headline"/>
                    <h1><span t-esc="name"/>.<br/><span class="pf-accent">Built to connect.</span></h1>
                    <p class="pf-lede" t-if="profile.summary" t-esc="profile.summary"/>
                    <p class="pf-lede" t-else="">Building thoughtful software across applications, infrastructure and the physical world.</p>
                    <div class="pf-actions">
                        <a class="pf-button pf-button-primary" href="#work">Explore my work</a>
                        <a class="pf-button pf-button-secondary" t-if="profile.email" t-att-href="'mailto:' + profile.email">Get in touch</a>
                    </div>
                </header>

                <section class="pf-section pf-section-rule" id="work" t-if="profile.skills">
                    <div class="pf-section-heading"><span>01</span><h2>Skills</h2></div>
                    <div class="pf-skill-grid">
                        <t t-foreach="profile.skills.splitlines()" t-as="skill">
                            <div class="pf-skill" t-if="skill.strip()"><span class="pf-skill-dot"/><p t-esc="skill"/></div>
                        </t>
                    </div>
                </section>

                <section class="pf-section pf-section-rule" id="experience" t-if="profile.experience">
                    <div class="pf-section-heading"><span>02</span><h2>Experience</h2></div>
                    <div class="pf-timeline"><div class="pf-rich-text" t-esc="profile.experience"/></div>
                </section>

                <section class="pf-section pf-split" id="about">
                    <div t-if="profile.education"><div class="pf-section-heading"><span>03</span><h2>Education</h2></div><div class="pf-rich-text" t-esc="profile.education"/></div>
                    <div t-if="profile.volunteering"><div class="pf-section-heading"><span>04</span><h2>Volunteering</h2></div><div class="pf-rich-text" t-esc="profile.volunteering"/></div>
                </section>
                <section class="pf-section pf-section-rule pf-split" t-if="profile.projects or profile.trainings or profile.languages">
                    <div t-if="profile.projects"><div class="pf-section-heading"><span>05</span><h2>Projects</h2></div><div class="pf-rich-text" t-esc="profile.projects"/></div>
                    <div t-if="profile.trainings"><div class="pf-section-heading"><span>06</span><h2>Trainings</h2></div><div class="pf-rich-text" t-esc="profile.trainings"/></div>
                    <div t-if="profile.languages"><div class="pf-section-heading"><span>07</span><h2>Languages</h2></div><div class="pf-rich-text" t-esc="profile.languages"/></div>
                </section>

                <footer class="pf-footer" id="contact">
                    <div><p class="pf-kicker">Have a good problem?</p><h2>Let’s build<br/>something useful.</h2></div>
                    <div class="pf-contact">
                        <a t-if="profile.email" t-att-href="'mailto:' + profile.email" t-esc="profile.email"/>
                        <a t-if="profile.linkedin" t-att-href="profile.linkedin">LinkedIn</a>
                        <a t-if="profile.github" t-att-href="profile.github">GitHub</a>
                        <span t-if="profile.location" t-esc="profile.location"/>
                    </div>
                </footer>
            </main>
        </t>
    </template>
</odoo>
