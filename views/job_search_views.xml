<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_job_search_list" model="ir.ui.view">
        <field name="name">job.search.list</field>
        <field name="model">job_finder.job_search</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_propose_searches" string="Propose searches" type="object" display="always"/>
                    <button name="action_search_now" string="Search now" type="object" display="always" class="oe_highlight"/>
                </header>
                <field name="cv_area_id"/>
                <field name="keywords"/>
                <field name="is_active"/>
                <field name="last_run_at"/>
                <field name="last_run_info"/>
            </list>
        </field>
    </record>
    <record id="view_job_search_form" model="ir.ui.view">
        <field name="name">job.search.form</field>
        <field name="model">job_finder.job_search</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_search_now" string="Search now" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group string="CV area searches">
                            <field name="profile_id"/>
                            <field name="cv_area_id" domain="[('profile_id', '=', profile_id)]"/>
                            <field name="keywords"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Search Locations">
                            <field name="cities"/>
                            <field name="is_remote"/>
                            <field name="is_australia"/>
                        </group>
                    </group>
                    <group string="Last run">
                        <field name="last_run_at"/>
                        <field name="last_run_info"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_job_search" model="ir.actions.act_window">
        <field name="name">Searches</field>
        <field name="res_model">job_finder.job_search</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_profile_job_search" model="ir.ui.view">
        <field name="name">profile.job.search</field>
        <field name="model">job.profile</field>
        <field name="inherit_id" ref="view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='portfolio']" position="before">
                <page name="job_search" string="Job search">
                    <group>
                        <group string="Visa &amp; work rights">
                            <field name="visa_status"/>
                            <field name="work_rights_until"/>
                        </group>
                        <group string="Search settings">
                            <field name="score_threshold"/>
                            <field name="max_offer_age"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
