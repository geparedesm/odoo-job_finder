          "fill": "$pf-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Controls use 44px minimum touch targets. Keyboard focus: 2px cyan outline with offset; hover: lighter violet border and underlined links. Project cards open a case study; technologies can filter the project list. Mobile uses a single column and explicit menu. Motion must respect reduced-motion preferences.",
          "lineHeight": 1.5,
          "fontFamily": "IBM Plex Sans",
          "fontSize": 17,
          "fontWeight": "normal"
