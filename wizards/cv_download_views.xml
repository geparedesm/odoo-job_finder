<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_finder_cv_download_form" model="ir.ui.view">
        <field name="name">job_finder.cv_download.form</field>
        <field name="model">job_finder.cv_download</field>
        <field name="arch" type="xml">
            <form string="Download CV">
                <field name="profile_id" invisible="1"/>
                <p class="text-muted">
                    Choose the areas of the job you apply for: the CV keeps the entries of those areas and the entries
                    without areas. Leave it empty for the complete CV.
                </p>
                <group>
                    <field name="area_ids" widget="many2many_checkboxes" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_download" type="object" string="Download PDF" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_job_finder_cv_download" model="ir.actions.act_window">
        <field name="name">Download CV</field>
        <field name="res_model">job_finder.cv_download</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
