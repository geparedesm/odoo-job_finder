<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_finder_experience_form" model="ir.ui.view">
        <field name="name">job_finder.experience.form</field>
        <field name="model">job_finder.experience</field>
        <field name="arch" type="xml">
            <form string="Role">
                <sheet>
                    <field name="profile_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="role"/>
                            <field name="company"/>
                            <field name="location"/>
                            <field name="employment_type"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="is_current"/>
                            <field name="date_end" invisible="is_current"/>
                            <field name="is_year_only"/>
                            <field name="is_public" widget="boolean_toggle"/>
                            <field name="is_secondary" widget="boolean_toggle" invisible="category != 'work'"/>
                            <field name="cv_area_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="What the role was about."/>
                        <field name="highlights" placeholder="One achievement per line."/>
                    </group>
                    <field name="project_ids" context="{'default_profile_id': profile_id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="is_featured" widget="boolean_favorite" nolabel="1"/>
                            <field name="name"/>
                            <field name="subtitle"/>
                            <field name="profile_id" column_invisible="True"/>
                            <field name="technology_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="description" optional="show"/>
                            <field name="cv_area_ids" widget="many2many_tags" optional="show"/>
                            <field name="is_public" widget="boolean_toggle"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_job_finder_project_form" model="ir.ui.view">
        <field name="name">job_finder.project.form</field>
        <field name="model">job_finder.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <sheet>
                    <field name="profile_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Project name"/></h1>
                        <field name="subtitle" placeholder="Client or a short description"/>
                    </div>
                    <group>
                        <group>
                            <field name="experience_id"/>
                            <field name="category"/>
                            <field name="technology_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="url" widget="url"/>
                        </group>
                        <group>
                            <field name="is_featured"/>
                            <field name="is_public" widget="boolean_toggle"/>
                            <field name="cv_area_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="What the project is and what you did. The first sentence is the summary."/>
                        </page>
                        <page string="Case study" name="case_study">
                            <div class="alert alert-info" role="status" invisible="is_featured">
                                Mark the project as Featured to publish its case-study page on the portfolio.
                            </div>
                            <group>
                                <group>
                                    <field name="area" placeholder="Access control"/>
                                    <field name="platforms" placeholder="Android · iOS · Web"/>
                                </group>
                                <group>
                                    <field name="cover_image" widget="image" options="{'size': [240, 135]}"/>
                                </group>
                            </group>
                            <group>
                                <field name="highlights" placeholder="Device protocol layer: Direct communication with the terminals."/>
                            </group>
                            <separator string="Key outcomes"/>
                            <field name="metric_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="value" placeholder="+40%"/>
                                    <field name="label" placeholder="Operations per minute"/>
                                </list>
                            </field>
                            <separator string="Architecture"/>
                            <field name="step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="detail"/>
                                    <field name="is_highlighted"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_job_finder_volunteering_form" model="ir.ui.view">
        <field name="name">job_finder.volunteering.form</field>
        <field name="model">job_finder.volunteering</field>
        <field name="arch" type="xml">
            <form string="Volunteering">
                <sheet>
                    <field name="profile_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="organisation"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="period"/>
                            <field name="is_public" widget="boolean_toggle"/>
                            <field name="cv_area_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="highlights" placeholder="One achievement per line."/>
                        <field name="recognitions" placeholder="One role or award per line."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_job_finder_technology_list" model="ir.ui.view">
        <field name="name">job_finder.technology.list</field>
        <field name="model">job_finder.technology</field>
        <field name="arch" type="xml">
            <list string="Technologies" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_job_finder_technology" model="ir.actions.act_window">
        <field name="name">Technologies</field>
        <field name="res_model">job_finder.technology</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
