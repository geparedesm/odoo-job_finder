<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A4 with even margins; the CV has no Odoo header or footer. -->
    <record id="paperformat_cv" model="report.paperformat">
        <field name="name">CV (A4)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">14</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_job_profile" model="ir.actions.report">
        <field name="name">Complete CV</field>
        <field name="model">job.profile</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">job_finder.report_job_profile</field>
        <field name="report_file">job_finder.report_job_profile</field>
        <field name="binding_model_id" ref="model_job_profile"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_cv"/>
        <field name="print_report_name">'%s - CV' % (object.full_name or 'Portfolio')</field>
    </record>
</odoo>
